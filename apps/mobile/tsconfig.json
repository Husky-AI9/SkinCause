{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@skincause/*": ["../../packages/*/src"]
    }
  },
  "include": ["app", "src", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
